<header class="sticky top-0 z-50 isolate border-b-2 border-cyan-400/35 bg-[#020713]/95 font-mono shadow-[0_6px_0_rgba(6,182,212,0.06),0_12px_32px_rgba(0,0,0,0.5)] backdrop-blur-md">
  <div class="h-1 bg-[repeating-linear-gradient(90deg,#22d3ee_0,#22d3ee_32px,transparent_32px,transparent_40px)] opacity-70"></div>
  <nav class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a class="group flex items-center gap-2 text-cyan-100 transition-colors duration-300 hover:text-white" href="/">
      <img
        src="/sasaki-blog-logo.svg"
        alt="Sasaki Blog"
        class="h-7 w-auto drop-shadow-[0_0_7px_rgba(34,211,238,0.3)] sm:h-9"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <form class="relative" action="/search/" method="get" role="search">
        <label class="sr-only" for="header-search">記事を検索</label>
        <input
          id="header-search"
          name="q"
          type="search"
          placeholder="SEARCH"
          class="w-24 border border-cyan-500/40 bg-[#030b1c] py-2 pr-9 pl-3 text-[11px] tracking-[0.14em] text-white outline-none transition-all duration-300 placeholder:text-slate-600 focus:border-cyan-300 focus:bg-cyan-950/20 focus:shadow-[inset_0_0_12px_rgba(34,211,238,0.08),0_0_10px_rgba(34,211,238,0.12)] sm:w-44"
        />
        <button class="absolute inset-y-0 right-1 flex w-8 items-center justify-center text-cyan-400 transition-colors duration-300 hover:text-white" type="submit" aria-label="検索する">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
          </svg>
        </button>
      </form>

      <div class="relative size-8 border border-cyan-500/30 bg-[#030b1c] p-1 text-cyan-300 transition-colors duration-300 hover:border-cyan-300 hover:text-white">
        <input type="checkbox" aria-label="メニューを開閉する" class="peer absolute inset-0 z-[70] size-8 cursor-pointer opacity-0" />
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 peer-checked:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="hidden size-6 peer-checked:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>

        <div class="absolute right-0 top-10 z-[60] hidden w-44 border border-cyan-400/40 bg-[#020713] text-xs tracking-[0.14em] shadow-[0_0_0_1px_rgba(8,145,178,0.12),8px_8px_0_rgba(0,0,0,0.45)] peer-checked:block">
          <div class="border-b border-cyan-400/20 bg-cyan-950/30 px-3 py-1.5 text-[9px] text-cyan-500">NAVIGATION.EXE</div>
          <a href="/" class="block px-4 py-3 text-white transition-colors duration-300 before:mr-2 before:text-cyan-400 before:content-['>'] hover:bg-cyan-950/60 hover:text-cyan-100">HOME</a>
          <a href="/about/" class="block border-t border-cyan-400/15 px-4 py-3 text-white transition-colors duration-300 before:mr-2 before:text-cyan-400 before:content-['>'] hover:bg-cyan-950/60 hover:text-cyan-100">ABOUT</a>
        </div>
      </div>
    </div>
  </nav>
</header>
