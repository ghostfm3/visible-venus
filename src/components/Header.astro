<header class="sticky top-0 z-50 isolate border-b border-cyan-400/15 bg-slate-950/80 font-mono shadow-[0_8px_32px_rgba(8,145,178,0.08)] backdrop-blur-xl">
  <nav class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-4 sm:px-6">
    <a class="group flex items-center gap-2 text-cyan-100 transition-colors duration-300 hover:text-white" href="/">
      <img
        src="/sasaki-blog-logo.svg"
        alt="Sasaki Blog"
        class="h-8 w-auto sm:h-10"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <form class="relative" action="/search/" method="get" role="search">
        <label class="sr-only" for="header-search">記事を検索</label>
        <input
          id="header-search"
          name="q"
          type="search"
          placeholder="SEARCH"
          class="w-24 rounded-full border border-cyan-400/25 bg-slate-900/80 py-2 pr-9 pl-3 text-xs tracking-wider text-cyan-50 outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-cyan-300 focus:ring-2 focus:ring-cyan-400/10 sm:w-44"
        />
        <button class="absolute inset-y-0 right-1 flex w-8 items-center justify-center text-cyan-400 transition-colors duration-300 hover:text-white" type="submit" aria-label="検索する">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
          </svg>
        </button>
      </form>

      <div class="relative size-8 text-cyan-300 transition-colors duration-300 hover:text-white">
        <input type="checkbox" aria-label="メニューを開閉する" class="peer absolute inset-0 z-[70] size-8 cursor-pointer opacity-0" />
        <svg xmlns="http://www.w3.org/2000/svg" class="size-8 peer-checked:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="hidden size-8 peer-checked:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>

        <div class="absolute right-0 top-10 z-[60] hidden w-44 overflow-hidden rounded-xl border border-cyan-400/20 bg-slate-950 text-sm shadow-2xl shadow-cyan-950/60 peer-checked:block">
          <a href="/" class="block px-4 py-3 text-slate-300 transition-colors duration-300 hover:bg-cyan-950/60 hover:text-cyan-100">HOME</a>
          <a href="/about/" class="block border-t border-cyan-400/10 px-4 py-3 text-slate-300 transition-colors duration-300 hover:bg-cyan-950/60 hover:text-cyan-100">ABOUT</a>
        </div>
      </div>
    </div>
  </nav>
</header>
