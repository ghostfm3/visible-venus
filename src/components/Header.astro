<header class="sticky top-0 z-50 isolate border-b border-white/25 bg-[#212121]">
  <nav class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a class="group flex items-center gap-2 transition-opacity duration-300 hover:opacity-70" href="/">
      <img
        src="/sasakilogo.svg"
        alt="Sasaki Blog"
        class="h-9 w-auto sm:h-10"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <form class="relative" action="/search/" method="get" role="search">
        <label class="sr-only" for="header-search">検索</label>
        <input
          id="header-search"
          name="q"
          type="search"
          placeholder="記事を探す…"
          class="w-28 border-0 border-b border-white/45 bg-transparent py-2 pr-9 pl-2 font-hand text-sm text-white outline-none transition-all duration-300 placeholder:text-white/50 focus:border-white sm:w-44"
        />
        <button class="absolute inset-y-0 right-1 flex w-8 items-center justify-center text-white/70 transition-colors duration-300 hover:text-white" type="submit" aria-label="検索する">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
          </svg>
        </button>
      </form>

      <div class="relative size-8 border border-white/35 p-1 text-white/80 transition-colors duration-300 hover:border-white hover:text-white">
        <input type="checkbox" aria-label="メニューを開閉する" class="peer absolute inset-0 z-[70] size-8 cursor-pointer opacity-0" />
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 peer-checked:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="hidden size-6 peer-checked:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>

        <div class="absolute right-0 top-10 z-[60] hidden w-44 border border-white/30 bg-[#7d7d7d] font-hand text-sm shadow-lg peer-checked:block">
          <div class="border-b border-white/20 px-3 py-2 text-xs text-white/60">menu</div>
          <a href="/" class="block px-4 py-3 text-white transition-colors duration-300 hover:bg-white/10">ホーム</a>
          <a href="/about/" class="block border-t border-white/15 px-4 py-3 text-white transition-colors duration-300 hover:bg-white/10">このブログについて</a>
        </div>
      </div>
    </div>
  </nav>
</header>
