---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  activeTag?: string;
  searchText?: string;
}

const { post, activeTag, searchText } = Astro.props;
---

<article
  class="group relative translate-y-0 overflow-hidden rounded-2xl border border-cyan-400/15 bg-slate-900/65 p-6 opacity-100 shadow-[0_16px_50px_rgba(0,0,0,0.28)] backdrop-blur-md transition-all duration-500 ease-out starting:translate-y-4 starting:opacity-0 hover:-translate-y-1 hover:border-cyan-300/40 hover:shadow-[0_18px_60px_rgba(8,145,178,0.16)] motion-reduce:transition-none"
  data-search-item={searchText ? true : undefined}
  data-search-text={searchText}
>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-300/80 to-transparent"></div>
  <div class="absolute -top-16 -right-16 size-32 rounded-full bg-cyan-400/5 blur-2xl transition-colors duration-500 group-hover:bg-cyan-400/10"></div>
  <div class="mb-4 flex items-center justify-between gap-3 font-mono">
    <time class="text-xs tracking-[0.16em] text-cyan-400">{post.data.publishedAt.toLocaleDateString("ja-JP")}</time>
  </div>
  <h2 class="font-mono text-2xl font-bold tracking-tight">
    <a class="text-slate-50 transition-colors duration-300 hover:text-cyan-200" href={`/blog/${post.id}/`}>{post.data.title}</a>
  </h2>
  <p class="mt-3 leading-relaxed text-slate-400">{post.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {post.data.tags.map((tag) => (
      <a
        class:list={[
          "rounded-full border px-2.5 py-1 font-mono text-xs transition-all duration-300 hover:-translate-y-0.5",
          activeTag === tag
            ? "border-cyan-300/60 bg-cyan-400/15 text-cyan-100"
            : "border-slate-700 bg-slate-950/50 text-slate-400 hover:border-cyan-400/40 hover:text-cyan-200",
        ]}
        href={`/tags/${encodeURIComponent(tag)}/`}
      >#{tag}</a>
    ))}
  </div>
  <a class="mt-5 inline-flex items-center gap-2 font-mono text-sm font-bold tracking-wider text-cyan-400 transition-all duration-300 hover:gap-3 hover:text-cyan-200" href={`/blog/${post.id}/`}>
    詳細を見る <span aria-hidden="true">→</span>
  </a>
</article>
