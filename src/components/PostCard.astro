---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  activeTag?: string;
  searchText?: string;
}

const { post, activeTag, searchText } = Astro.props;
---

<article
  class="group translate-y-0 border-b border-white/35 px-1 py-7 opacity-100 transition-all duration-300 ease-out starting:translate-y-4 starting:opacity-0 hover:border-white/60 sm:px-2 motion-reduce:transition-none"
  data-search-item={searchText ? true : undefined}
  data-search-text={searchText}
>
  <div class="mb-3 flex items-center justify-between gap-3 font-hand">
    <time class="text-sm tracking-[0.08em] text-white/70">{post.data.publishedAt.toLocaleDateString("ja-JP")}</time>
    <span class="text-xs text-white/45">diary entry</span>
  </div>
  <h2 class="font-hand text-2xl font-normal tracking-wide sm:text-3xl">
    <a class="text-white decoration-white/40 decoration-1 underline-offset-4 transition-colors duration-300 hover:text-white/75 hover:underline" href={`/blog/${post.id}/`}>{post.data.title}</a>
  </h2>
  <p class="mt-3 text-sm leading-8 text-white/75">{post.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {post.data.tags.map((tag) => (
      <a
        class:list={[
          "rounded-full border px-3 py-1 text-xs transition-all duration-300 hover:-translate-y-0.5",
          activeTag === tag
            ? "border-white bg-white/15 text-white"
            : "border-white/30 text-white/70 hover:border-white/70 hover:text-white",
        ]}
        href={`/tags/${encodeURIComponent(tag)}/`}
      >#{tag}</a>
    ))}
  </div>
  <a class="mt-5 inline-flex border-b border-white/45 px-1 py-1 font-hand text-sm tracking-[0.08em] text-white/80 transition-all duration-300 hover:border-white hover:text-white" href={`/blog/${post.id}/`}>
    続きを読む <span class="ml-2" aria-hidden="true">→</span>
  </a>
</article>
