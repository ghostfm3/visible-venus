---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
      a.id.localeCompare(b.id),
  );
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout title={`#${tag}の記事 | Sasakiのblog`} description={`${tag}タグの記事一覧`}>
  <section class="mb-8 border-b border-white/45 px-1 py-5">
    <a class="font-hand text-sm tracking-wider text-white/70 transition-colors hover:text-white" href="/">← 記事一覧へ戻る</a>
    <h1 class="mt-5 font-hand text-3xl font-normal tracking-wide text-white sm:text-4xl">#{tag}</h1>
    <p class="mt-2 text-xs tracking-wider text-white/60">{posts.length} 件の記事</p>
  </section>

  <div class="space-y-6">
    {posts.map((post) => <PostCard post={post} activeTag={tag} />)}
  </div>
</Layout>
