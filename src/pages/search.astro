---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
    a.id.localeCompare(b.id),
);
---

<Layout title="記事検索 | Sasaki's Diary" description="ブログ内の記事を検索します">
  <section class="mb-8 border-b border-white/45 px-1 py-5">
    <p class="font-hand text-sm tracking-[0.2em] text-white/60">FIND A MEMORY</p>
    <h1 class="mt-2 font-hand text-3xl font-normal text-white sm:text-4xl">記事を探す</h1>
    <p id="search-summary" class="mt-3 text-sm text-white/70">検索キーワードを入力してください。</p>
  </section>

  <div class="space-y-6" id="search-results">
    {posts.map((post) => (
      <PostCard
        post={post}
        searchText={[post.data.title, post.data.description, post.data.author, ...post.data.tags].join(" ")}
      />
    ))}
  </div>

  <p id="search-empty" class="hidden border border-white/30 p-8 text-center text-sm text-white/75">
    該当する記事が見つかりませんでした。
  </p>

  <script>
    const query = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
    const normalizedQuery = query.toLocaleLowerCase("ja");
    const items = [...document.querySelectorAll<HTMLElement>("[data-search-item]")];
    const summary = document.querySelector<HTMLElement>("#search-summary");
    const empty = document.querySelector<HTMLElement>("#search-empty");
    const headerInput = document.querySelector<HTMLInputElement>("#header-search");

    if (headerInput) headerInput.value = query;

    let visibleCount = 0;
    items.forEach((item) => {
      const text = (item.dataset.searchText ?? "").toLocaleLowerCase("ja");
      const matches = normalizedQuery === "" || text.includes(normalizedQuery);
      item.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    if (summary) {
      summary.textContent = query
        ? `「${query}」の検索結果：${visibleCount}件`
        : `すべての記事：${visibleCount}件`;
    }
    empty?.classList.toggle("hidden", visibleCount !== 0);
  </script>
</Layout>
