---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import PostCard from "../components/PostCard.astro";

const PAGE_SIZE = 3;
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
    a.id.localeCompare(b.id),
);
---

<Layout title="Sasakiのblog">
  <div class="relative mb-6 flex items-end justify-between border-l-4 border-cyan-400 bg-[#030b1c]/85 px-4 py-3 shadow-[inset_0_1px_rgba(34,211,238,0.18),inset_0_-1px_rgba(34,211,238,0.18)]">
    <div>
      <p class="font-mono text-[10px] font-bold tracking-[0.28em] text-cyan-400">DATABASE://ARTICLE_INDEX</p>
      <h1 class="mt-1 font-mono text-2xl font-bold tracking-[0.04em] text-white sm:text-3xl">記事一覧<span class="ml-2 animate-pulse text-cyan-300">_</span></h1>
    </div>
  </div>

  <div class="space-y-5" id="article-list">
    {posts.map((post, index) => (
      <div
        class:list={[
          "translate-y-0 opacity-100 transition-all duration-300 ease-out motion-reduce:transition-none",
          index >= PAGE_SIZE && "hidden",
        ]}
        data-pagination-item
      >
        <PostCard post={post} />
      </div>
    ))}
  </div>

  <Pagination totalItems={posts.length} pageSize={PAGE_SIZE} />
</Layout>
