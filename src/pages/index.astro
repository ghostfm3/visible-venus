---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import PostCard from "../components/PostCard.astro";

const PAGE_SIZE = 3;
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
    a.id.localeCompare(b.id),
);
---

<Layout title="Sasakiの記憶">
  <div class="mb-2 border-b border-white/45 px-1 py-3">
    <div>
      <p class="font-hand text-sm tracking-[0.18em] text-white/60">MEMORIES & NOTES</p>
      <h1 class="mt-1 font-hand text-3xl font-normal tracking-[0.08em] text-white sm:text-4xl">記事一覧</h1>
    </div>
  </div>

  <div class="space-y-5" id="article-list">
    {posts.map((post, index) => (
      <div
        class:list={[
          "translate-y-0 opacity-100 transition-all duration-300 ease-out motion-reduce:transition-none",
          index >= PAGE_SIZE && "hidden",
        ]}
        data-pagination-item
      >
        <PostCard post={post} />
      </div>
    ))}
  </div>

  <Pagination totalItems={posts.length} pageSize={PAGE_SIZE} />
</Layout>
